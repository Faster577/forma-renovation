# Resend transactional email (https://resend.com)
# Leave empty to run the inquiry form in demo mode (no email is sent).

RESEND_API_KEY=
INQUIRY_TO_EMAIL=ahoj@forma.studio
INQUIRY_FROM_EMAIL="FORMA. <onboarding@resend.dev>"

# Notes:
# - RESEND_API_KEY: API key from the Resend dashboard
# - INQUIRY_TO_EMAIL: inbox that receives renovation inquiries
# - INQUIRY_FROM_EMAIL: verified sender in Resend (use onboarding@resend.dev for tests)
# - Never commit real secrets. Copy this file to `.env.local` for local development.

# Public site origin for canonical URLs, Open Graph and sitemap.xml
# Example on Vercel: https://your-project.vercel.app
# Leave empty locally if you do not need absolute URLs yet.
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Sanity CMS (https://www.sanity.io)
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty until you create/connect a project.
# The site keeps using static demo content until Sanity is configured and populated.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: Viewer token for authenticated / draft fetches (not required for public CDN reads)
# SANITY_API_READ_TOKEN=

# Shared secret for /api/revalidate (Sanity webhook → Next.js cache tags)
# Generate a long random string and set the same value in the Sanity webhook Authorization header:
#   Authorization: Bearer <SANITY_REVALIDATE_SECRET>
# In local development, leaving this empty allows GET/POST /api/revalidate without auth.
SANITY_REVALIDATE_SECRET=

# Notes:
# - Create a project at https://www.sanity.io/manage or via `npx sanity@latest login` + init
# - Copy the Project ID into NEXT_PUBLIC_SANITY_PROJECT_ID
# - Add http://localhost:3000 (and your production origin) under API → CORS origins
#   with "Allow credentials" enabled so /studio can authenticate
# - Open the embedded Studio at http://localhost:3000/studio after configuring env
# - Optional webhook: https://www.sanity.io/manage → API → Webhooks → POST /api/revalidate
#   so published Website content / projects refresh without deleting .next
